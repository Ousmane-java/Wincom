# Formulaire de devis : envoi des demandes par email via Resend (https://resend.com)
RESEND_API_KEY=
# Adresse qui REÇOIT les demandes de devis
CONTACT_TO_EMAIL=contact@wincomconsulting.com
# Expéditeur (domaine vérifié chez Resend). Par défaut : onboarding@resend.dev (tests uniquement)
CONTACT_FROM_EMAIL="Wincom <contact@wincomconsulting.com>"
# "true" pour envoyer un email de confirmation automatique au prospect (domaine vérifié requis)
SEND_CONFIRMATION=false
